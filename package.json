{
  "name": "stars-academy-website",
  "version": "1.0.0",
  "private": true,
  "description": "STARS Academy website \u2014 pediatric developmental day treatment, Batesville, Arkansas.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run test && npm run build && npm run test:e2e",
    "placeholders": "node scripts/list-placeholders.mjs",
    "images": "node scripts/generate-images.mjs",
    "vercel:config": "node scripts/generate-vercel-config.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.56.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
