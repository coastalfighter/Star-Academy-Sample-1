# Canonical site origin used for canonical URLs, Open Graph URLs and sitemap.xml.
# Production: https://www.mystarsacademy.org   Staging: your preview URL.
PUBLIC_SITE_URL=https://www.mystarsacademy.org

# Google Analytics 4 measurement ID (owned by a STARS Google account).
# Leave empty to disable analytics entirely (no script is loaded).
PUBLIC_GA4_ID=

# Set to "true" on staging/preview builds so search engines never index them.
PUBLIC_NOINDEX=false
