---
/**
 * New page. The current site has no pathway for physicians, therapists or
 * schools. Designed for a busy clinician: an at-a-glance panel first, then
 * criteria, the referral steps, clinical scope and a contact form that
 * deliberately collects no protected health information.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Steps from '@/components/Steps.astro';
import Faq from '@/components/Faq.astro';
import Icon from '@/components/Icon.astro';
import Rich from '@/components/Rich.astro';
import Confirm from '@/components/Confirm.astro';
import NextSteps from '@/components/NextSteps.astro';
import ReferralForm from '@/components/forms/ReferralForm.astro';
import { SITE } from '@/lib/site';
import { breadcrumbSchema, faqSchema } from '@/lib/seo';

const site = Astro.site ?? new URL('https://www.mystarsacademy.org');
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'For Referral Partners', href: '/referrals' },
];
const faqs = (await getCollection('faqs'))
  .map((f) => f.data)
  .filter((f) => f.audience === 'referrals')
  .sort((a, b) => a.order - b.order);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const glance = [
  { k: 'Program', v: 'Pediatric developmental day treatment — full-day, center-based' },
  { k: 'Ages', v: 'Birth to 6 years' },
  { k: 'Services', v: 'Speech-language, occupational and physical therapy; licensed nursing; developmental classrooms' },
  { k: 'Funding', v: 'Medicaid, including ARKids First-A, SSI and TEFRA' },
  { k: 'Requires', v: 'Prescription from the child’s primary care physician' },
  { k: 'Languages', v: 'Speech-language evaluation and therapy available in Spanish' },
  { k: 'Hours', v: `${SITE.hours.days}, ${SITE.hours.open} – ${SITE.hours.close}` },
];

const steps = [
  {
    title: 'Talk with the family',
    body: 'Share STARS as an option. Families can call us directly or request a tour — we’ll take it from there.',
  },
  {
    title: 'Send the referral',
    body: 'Contact our team by phone or with the form below. [CLIENT TO CONFIRM: fax number or secure method for prescriptions and records]',
  },
  {
    title: 'We connect with the family',
    body: 'STARS contacts the family, arranges evaluation and a tour, and verifies coverage.',
  },
  {
    title: 'Coordinated care',
    body: 'Our therapists and nurses communicate with the child’s physicians and other professionals as needed.',
  },
];
---

<BaseLayout
  title="For Physicians & Referral Partners"
  description="Refer a child to STARS Academy in Batesville, AR: pediatric day treatment for children birth to six with speech, OT, PT, on-site nursing and developmental classrooms. Eligibility and referral steps."
  jsonLd={[breadcrumbSchema(crumbs, site), faqSchema(faqs)]}
>
  <PageHero
    eyebrow="For physicians, therapists & schools"
    title="Referring a child to STARS, <em>made simple.</em>"
    lede="Everything you need before referring — who we serve, eligibility, clinical scope and how to send a prescription — on one page."
    crumbs={crumbs}
  >
    <Fragment slot="actions">
      <a class="btn" href="#refer">Start a referral <span class="btn__arrow"><Icon name="arrow-right" size={18} /></span></a>
      <a class="btn btn--secondary" href={SITE.phoneHref}><Icon name="phone" size={18} /> {SITE.phone}</a>
    </Fragment>
    <div slot="aside" class="glance">
      <h2 class="glance__title">STARS at a glance</h2>
      <dl>
        {
          glance.map((g) => (
            <div>
              <dt>{g.k}</dt>
              <dd>{g.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="criteria-title">
    <div class="container split">
      <div class="stack">
        <p class="eyebrow">Eligibility</p>
        <h2 id="criteria-title">Referral criteria</h2>
        <p class="muted">A child is eligible for services at STARS when they:</p>
      </div>
      <ol role="list" class="criteria">
        <li>Have active health insurance (Medicaid funding, including ARKids First-A, SSI and TEFRA).</li>
        <li>
          Qualify in developmental services <strong>and</strong> at least one of: speech therapy, occupational therapy,
          physical therapy or nursing services.
        </li>
        <li>Have treatment prescribed by their primary care physician.</li>
      </ol>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="how-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How to refer</p>
        <h2 id="how-title">Four steps, and we handle most of them.</h2>
      </div>
      <Steps steps={steps} />
      <p class="small muted referral-packet">
        <Confirm note="Downloadable referral packet / prescription form for physicians' offices (PDF)" />
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="scope-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Clinical scope</p>
        <h2 id="scope-title">What our team routinely supports.</h2>
      </div>
      <div class="scope">
        {
          services
            .filter((s) => s.data.forProviders)
            .map((s) => (
              <details class="scope__item">
                <summary>
                  <span>{s.data.title}</span>
                  <Icon name="plus" size={20} />
                </summary>
                <div class="scope__body">
                  {s.data.forProviders?.intro && <Rich as="p" text={`${s.data.forProviders.intro}:`} />}
                  <ul role="list">
                    {s.data.forProviders?.items.map((i) => (
                      <li>
                        <Rich text={i} />
                      </li>
                    ))}
                  </ul>
                  <a class="link-arrow" href={s.data.path}>
                    {s.data.title} at STARS <Icon name="arrow-right" size={18} />
                  </a>
                </div>
              </details>
            ))
        }
      </div>
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="schools-title">
    <div class="container split">
      <div class="stack">
        <p class="eyebrow">For school districts</p>
        <h2 id="schools-title">Partners in the move to kindergarten.</h2>
      </div>
      <div class="stack">
        <p class="lede">
          The move from preschool to public school is a big one. Our team works with parents and local school districts to
          make that transition as smooth as possible.
        </p>
        <p class="small"><Confirm note="Districts STARS currently partners with, and the transition process (records, meetings, timelines)" /></p>
      </div>
    </div>
  </section>

  <section class="section" id="refer" aria-labelledby="refer-title">
    <div class="container refer">
      <div class="stack">
        <p class="eyebrow">Make a referral</p>
        <h2 id="refer-title">Request a call back from our team.</h2>
        <p class="lede">We’ll follow up with your office to confirm what we need and how to send it securely.</p>
        <div class="refer__note">
          <Icon name="phone" size={20} />
          <p>
            <strong>Prefer to call?</strong><br />
            <a href={SITE.phoneHref}>{SITE.phone}</a> · {SITE.hours.days}, {SITE.hours.open} – {SITE.hours.close}
            <br />
            <span class="small">Fax: <Confirm note="Referral fax number" /></span>
          </p>
        </div>
      </div>
      <ReferralForm />
    </div>
  </section>

  <section class="section section--white" aria-labelledby="faq-title">
    <div class="container split">
      <div class="stack">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-title">Referral FAQs</h2>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <NextSteps
    heading="Visit STARS before you refer."
    body="Many providers find it helpful to see our program in person. We’re glad to arrange a visit for you or your staff."
    primary={{ label: 'Schedule a visit', href: '/schedule-a-tour' }}
    secondary={{ label: 'Contact us', href: '/contact-us' }}
    links={[
      { label: 'Our approach', href: '/approach', description: 'Relationships, regulation and neuroaffirming care.' },
      { label: 'All services', href: '/services', description: 'How our disciplines work together.' },
    ]}
  />
</BaseLayout>

<style>
  .glance {
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--navy-900);
    color: #e9e8f3;
    border-radius: var(--radius-l);
  }
  .glance__title {
    font-size: var(--step-2);
    color: #ffffff;
    margin-bottom: var(--space-s);
  }
  .glance dl > div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--space-s);
    padding-block: 0.65rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }
  .glance dt {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold-400);
    padding-top: 0.1rem;
  }
  .glance dd {
    font-size: 0.975rem;
    line-height: 1.5;
  }
  .split {
    display: grid;
    gap: var(--space-l);
  }
  .criteria {
    display: grid;
    gap: var(--space-s);
    padding-left: 1.4rem;
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .criteria li::marker {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--red-700);
  }
  .referral-packet {
    margin-top: var(--space-l);
  }
  .scope {
    display: grid;
    gap: var(--space-s);
  }
  .scope__item {
    background: var(--white);
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-m);
  }
  .scope__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-s) var(--space-m);
    min-height: 3.5rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--navy-900);
  }
  .scope__item summary::-webkit-details-marker {
    display: none;
  }
  .scope__item summary :global(svg) {
    flex: none;
    transition: transform var(--duration-m) var(--ease-out);
  }
  .scope__item[open] summary :global(svg) {
    transform: rotate(45deg);
  }
  .scope__body {
    display: grid;
    gap: var(--space-s);
    padding: 0 var(--space-m) var(--space-m);
    color: var(--ink-700);
  }
  .scope__body ul {
    columns: 2 16rem;
    column-gap: var(--space-l);
    padding-left: 1.1rem;
  }
  .scope__body li {
    break-inside: avoid;
    padding-bottom: 0.35rem;
  }
  .scope__body li::marker {
    color: var(--red-600);
  }
  .refer {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }
  .refer__note {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: var(--space-xs);
    padding: var(--space-s);
    background: var(--sand-100);
    border-radius: var(--radius-m);
  }
  .refer__note :global(svg) {
    color: var(--red-600);
    margin-top: 0.2rem;
  }
  @media (min-width: 56em) {
    .split {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--space-2xl);
      align-items: start;
    }
  }
  @media (min-width: 64em) {
    .refer {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--space-2xl);
    }
  }
</style>
