---
/**
 * Replaces /general-8. Written for the candidate STARS most needs to
 * persuade — licensed therapists and nurses — while keeping every
 * existing role and its requirements accurate.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Steps from '@/components/Steps.astro';
import Faq from '@/components/Faq.astro';
import Icon from '@/components/Icon.astro';
import Rich from '@/components/Rich.astro';
import Photo from '@/components/Photo.astro';
import Confirm from '@/components/Confirm.astro';
import NextSteps from '@/components/NextSteps.astro';
import { SITE } from '@/lib/site';
import { breadcrumbSchema, faqSchema } from '@/lib/seo';

const site = Astro.site ?? new URL('https://www.mystarsacademy.org');
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Careers', href: '/careers' },
];
const jobs = (await getCollection('jobs'))
  .filter((j) => j.data.status !== 'closed')
  .sort((a, b) => a.data.order - b.data.order);
const faqs = (await getCollection('faqs'))
  .map((f) => f.data)
  .filter((f) => f.audience === 'careers')
  .sort((a, b) => a.order - b.order);

const reasons = [
  {
    title: 'A true interdisciplinary team',
    body: 'Speech, occupational and physical therapists, nurses and classroom teams work under one roof, around the same children — every day, not just at a quarterly meeting.',
  },
  {
    title: 'Time to really know each child',
    body: 'Children spend the whole day at STARS. You see how they play, eat, move and communicate across the day — and your work carries over into real moments.',
  },
  {
    title: 'A culture that takes care of adults, too',
    body: 'Our Adult First mindset recognizes that caring well for children starts with the adults who do it. Regulated, supported adults are the foundation of the work.',
  },
  {
    title: 'An approach you can believe in',
    body: 'Relationship-based, sensory-informed and neuroaffirming. If you’ve wanted to practice this way, you’ll be among colleagues who share it.',
  },
];

const hiring = [
  { title: 'Tell us about you', body: 'Send your details and résumé using our short online form.' },
  { title: 'Complete the application', body: 'Fill out the official STARS employment application online.' },
  { title: 'Meet the team', body: 'Interview, tour the building and ask us anything. [CLIENT TO CONFIRM: interview steps]' },
  { title: 'Welcome aboard', body: 'Complete any pre-employment requirements for your role, such as a drug screen, and start orientation.' },
];
---

<BaseLayout
  title="Careers — Therapists, Nurses & Educators"
  description="Join STARS Academy in Batesville, Arkansas. Work alongside speech, occupational and physical therapists, nurses and early childhood educators in a relationship-based, neuroaffirming program."
  jsonLd={[breadcrumbSchema(crumbs, site), faqSchema(faqs)]}
>
  <PageHero
    eyebrow="Careers at STARS"
    title="Do the work you trained for, <em>with a team behind you.</em>"
    lede={`About ${SITE.staffCount} therapists, nurses, educators and support staff make STARS what it is. If you want to do meaningful work with young children — as part of a team that actually works together — we’d love to meet you.`}
    crumbs={crumbs}
    photo={{ brief: 'A therapist and classroom teacher planning together at a low table after the children leave — candid, warm.', tone: 'navy', image: 'easel-support' }}
  >
    <Fragment slot="actions">
      <a class="btn" href="#openings">See open roles <span class="btn__arrow"><Icon name="arrow-right" size={18} /></span></a>
      <a class="btn btn--secondary" href="/careers/apply">Apply now</a>
    </Fragment>
  </PageHero>

  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Why STARS</p>
        <h2 id="why-title">Why therapists, nurses and educators choose STARS.</h2>
      </div>
      <ul role="list" class="why">
        {
          reasons.map((r, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 80}ms`}>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="life-title">
    <div class="container life">
      <Photo image="colleagues-planning" ratio="4 / 3" tone="teal" brief="Staff team photo outdoors or in the gym — real people, relaxed, not posed in rows." />
      <div class="stack">
        <p class="eyebrow">Life at STARS</p>
        <h2 id="life-title">What working here is like.</h2>
        <p class="lede">
          Our values — positivity, purpose, communication, empowerment and adaptability — aren’t posters on a wall. They shape
          how we hire, how we support each other and how we show up for children.
        </p>
        <p><Confirm note="Benefits (health insurance, PTO, CEUs/professional development, schedule), and 1–2 short staff quotes shared with permission" /></p>
        <a class="link-arrow" href="/about-us#values">Our values <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section" id="openings" aria-labelledby="openings-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="stack">
          <p class="eyebrow">Open roles</p>
          <h2 id="openings-title">Positions at STARS</h2>
        </div>
        <p class="muted">
          We hire for these roles on an ongoing basis. Don’t see your role? Apply anyway — we’d like to hear from you.
        </p>
      </div>
      <div class="jobs">
        {
          jobs.map((job) => (
            <article class="job" aria-labelledby={`job-${job.id}`}>
              <div class="job__head">
                <p class="job__team">{job.data.team}</p>
                <h3 id={`job-${job.id}`}>
                  {job.data.title}
                  {job.data.abbreviation && <span class="job__abbr"> ({job.data.abbreviation})</span>}
                </h3>
              </div>
              <Rich as="p" class="job__summary" text={job.data.summary} />
              <div class="job__req">
                <h4>Requirements</h4>
                <ul role="list">
                  {job.data.requirements.map((r) => (
                    <li>
                      <Rich text={r} />
                    </li>
                  ))}
                </ul>
              </div>
              <a class="btn btn--secondary btn--small job__apply" href={`/careers/apply?position=${encodeURIComponent(job.data.title)}`}>
                Apply<span class="visually-hidden"> for {job.data.title}</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="hiring-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How hiring works</p>
        <h2 id="hiring-title">Four simple steps.</h2>
      </div>
      <Steps steps={hiring} />
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container faqwrap">
      <div class="stack">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-title">Careers FAQ</h2>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <NextSteps
    heading="Ready to join the STARS team?"
    body="Send us your information and résumé — we look forward to hearing from you."
    primary={{ label: 'Apply now', href: '/careers/apply' }}
    secondary={{ label: 'Our approach', href: '/approach' }}
  />
</BaseLayout>

<style>
  .why {
    display: grid;
    gap: var(--space-l) var(--space-xl);
    padding: 0;
    list-style: none;
  }
  .why li {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
    padding-top: var(--space-s);
    border-top: 2px solid var(--navy-900);
  }
  .why h3 {
    font-size: var(--step-2);
  }
  .why p {
    color: var(--ink-700);
  }
  .life {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }
  .jobs {
    display: grid;
    gap: var(--space-s);
  }
  .job {
    display: grid;
    gap: var(--space-s);
    padding: var(--space-m);
    background: var(--white);
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-m);
  }
  .job__team {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--red-700);
  }
  .job h3 {
    font-size: var(--step-2);
  }
  .job__abbr {
    font-family: var(--font-body);
    font-size: var(--step-0);
    color: var(--ink-600);
  }
  .job__summary {
    color: var(--ink-700);
  }
  .job__req h4 {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-600);
  }
  .job__req ul {
    margin-top: 0.35rem;
    padding-left: 1.1rem;
    color: var(--ink-900);
  }
  .job__req li::marker {
    color: var(--red-600);
  }
  .job__apply {
    justify-self: start;
    align-self: start;
  }
  .faqwrap {
    display: grid;
    gap: var(--space-l);
  }
  @media (min-width: 48em) {
    .why {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 60em) {
    .life {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }
    .job {
      grid-template-columns: 1fr 1.3fr 1fr auto;
      align-items: start;
      gap: var(--space-l);
    }
    .faqwrap {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--space-2xl);
    }
  }
</style>
