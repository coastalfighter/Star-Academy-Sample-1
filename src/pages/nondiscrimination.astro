---
import LegalLayout from '@/layouts/LegalLayout.astro';
import Confirm from '@/components/Confirm.astro';
---

<LegalLayout
  title="Nondiscrimination Statement"
  path="/nondiscrimination"
  eyebrow="Nondiscrimination"
  heading="Nondiscrimination statement"
  lede="STARS Academy participates in programs funded by the U.S. Department of Agriculture."
  description="USDA nondiscrimination statement for STARS Academy, Batesville, Arkansas."
>
  <p>
    In accordance with Federal civil rights law and U.S. Department of Agriculture (USDA) civil rights regulations and
    policies, this institution is prohibited from discriminating based on race, color, national origin, sex (including gender
    identity and sexual orientation), disability, age, or reprisal or retaliation for prior civil rights activity in any
    program or activity conducted or funded by USDA.
  </p>
  <p>
    <Confirm note="Insert the complete, current USDA nondiscrimination statement (including program-information and complaint-filing instructions) exactly as provided by STARS' sponsoring agency" />
  </p>
  <p>This institution is an equal opportunity provider.</p>
</LegalLayout>
