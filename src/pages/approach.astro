---
/**
 * Approach / philosophy. The client's brief names these ideas as central to
 * who STARS is, yet the current site never mentions them. Each idea is
 * given a plain-language meaning and a "what it can look like" example so
 * visitors with no background can follow along.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import NextSteps from '@/components/NextSteps.astro';
import Photo from '@/components/Photo.astro';
import Confirm from '@/components/Confirm.astro';
import DuoIcon from '@/components/graphics/DuoIcon.astro';
import { breadcrumbSchema } from '@/lib/seo';

const site = Astro.site ?? new URL('https://www.mystarsacademy.org');
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Our Approach', href: '/approach' },
];

const ideas = [
  {
    id: 'relationships',
    icon: 'team' as const,
    term: 'Relationships & connection',
    plain: 'Children learn from people they trust.',
    meaning:
      'Before a child can work on a new skill, they need to feel safe with the adult beside them. We invest in relationships first — learning each child’s cues, comforts and interests — because connection is what makes learning possible.',
    looks: 'Greeting each child by name at eye level. Staying with a child through a hard moment instead of sending them away.',
  },
  {
    id: 'regulation',
    icon: 'calm' as const,
    term: 'Regulation',
    plain: 'A calm body and brain are ready to learn.',
    meaning:
      '“Regulation” means being able to return to calm after stress, excitement or frustration. Young children can’t do this alone yet — they borrow calm from the adults around them. We help children build that skill step by step.',
    looks: 'Calm-down spaces in classrooms. Breathing and movement routines. Adults who stay steady when a child is upset.',
  },
  {
    id: 'conscious-discipline',
    icon: 'heart' as const,
    term: 'Conscious Discipline',
    plain: 'A shared approach to feelings, behavior and belonging.',
    meaning:
      'Conscious Discipline is a widely used social-emotional learning approach for schools and early childhood programs. It gives adults and children a common set of skills for staying calm, solving problems and caring for one another — and treats everyday conflicts as chances to teach, not punish.',
    looks: 'Classroom routines that build a sense of family. Helping children name feelings. Teaching what to do instead of only saying “stop.”',
    link: { href: 'https://consciousdiscipline.com/', label: 'Learn more at consciousdiscipline.com' },
  },
  {
    id: 'adult-first',
    icon: 'shield' as const,
    term: 'Adult First',
    plain: 'Adults manage their own emotions first.',
    meaning:
      'Children mirror the adults around them. An “Adult First” mindset means our staff practice noticing and managing their own stress, so they can respond to children with patience instead of reacting. It shapes how we support our team, too.',
    looks: 'A teacher taking a breath before responding. Leaders who make space for staff to reset. A calmer building for everyone.',
  },
  {
    id: 'sensory',
    icon: 'senses' as const,
    term: 'Sensory-informed',
    plain: 'Every sense matters.',
    meaning:
      'Some children experience sound, light, touch, taste or movement more intensely than others — or seek out more of it. What can look like “misbehavior” is often a child’s body asking for help. We notice those needs and plan for them.',
    looks: 'Sensory play built into each day. Movement breaks. Adjusting lighting, noise or seating for a child who needs it.',
  },
  {
    id: 'neuroaffirming',
    icon: 'neuro' as const,
    term: 'Neuroaffirming',
    plain: 'Different, not less.',
    meaning:
      'Children’s brains work in many different ways. A neuroaffirming approach respects those differences — including autistic children and children with other developmental differences — and builds on each child’s strengths, rather than trying to make them appear “typical.”',
    looks: 'Honoring a child’s way of communicating, whether that’s words, pictures or a device. Building goals around independence and joy, not conformity.',
  },
];
---

<BaseLayout
  title="Our Approach: Relationships & Regulation"
  description="How STARS Academy works with children: relationships first, regulation, Conscious Discipline, an Adult First mindset, and sensory-informed, neuroaffirming care — explained in plain language."
  jsonLd={[breadcrumbSchema(crumbs, site)]}
>
  <PageHero
    eyebrow="Our approach"
    title="Children learn best when they feel <em>safe, connected and understood.</em>"
    lede="That single idea shapes everything at STARS — how our classrooms run, how therapists work, and how we support our own team. Here’s what our approach means, without the jargon."
    crumbs={crumbs}
    photo={{ brief: 'A teacher kneeling beside an upset toddler, one hand offered, calm expression — a moment of co-regulation.', tone: 'sand', image: 'teacher-hugs' }}
  />

  <section class="section section--tight" aria-label="In short">
    <div class="container short">
      <p class="short__lead">
        <span class="short__label">In short</span>
        We start with <strong>connection</strong>, help children find <strong>calm</strong>, respect how each child’s
        <strong>brain and body</strong> work — and then build skills from there.
      </p>
    </div>
  </section>

  <nav class="container jump" aria-label="Ideas on this page">
    <ul role="list">
      {
        ideas.map((i) => (
          <li>
            <a href={`#${i.id}`}>{i.term}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="container ideas">
    {
      ideas.map((idea, i) => (
        <section class="idea" id={idea.id} aria-labelledby={`${idea.id}-title`} data-reveal>
          <div class="idea__head">
            <span class="idea__mark" aria-hidden="true">
              <DuoIcon name={idea.icon} tone={(['gold', 'teal', 'red'] as const)[i % 3]} size={28} chip />
              <span class="idea__n">{String(i + 1).padStart(2, '0')}</span>
            </span>
            <p class="idea__term eyebrow">{idea.term}</p>
            <h2 id={`${idea.id}-title`}>{idea.plain}</h2>
          </div>
          <div class="idea__body">
            <p>{idea.meaning}</p>
            <div class="idea__looks" data-tilt>
              <p class="idea__looks-label">What it can look like</p>
              <p>{idea.looks}</p>
            </div>
            {idea.link && (
              <p class="small">
                <a href={idea.link.href} target="_blank" rel="noopener">
                  {idea.link.label}
                  <span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </p>
            )}
          </div>
        </section>
      ))
    }
    <p class="ideas__note small">
      <Confirm note="STARS leadership to review these descriptions and examples for accuracy" />
    </p>
  </div>

  <section class="section section--sand" aria-labelledby="means-title">
    <div class="container means">
      <div class="means__col stack">
        <p class="eyebrow">For families</p>
        <h2 id="means-title">What this means for your child</h2>
        <ul role="list">
          <li>Your child is known as a whole person — not a list of goals.</li>
          <li>Hard moments are met with patience and teaching, not punishment.</li>
          <li>Sensory and communication differences are understood and supported.</li>
          <li>Progress is measured by what matters in your family’s daily life.</li>
        </ul>
        <a class="btn" href="/getting-started">Is STARS right for my child?</a>
      </div>
      <div class="means__col stack">
        <Photo tilt image="colleagues-laughing" ratio="4 / 3" tone="navy" brief="Two STARS staff members sharing a quiet laugh in the break room — the Adult First culture in action." />
        <p class="eyebrow">For our team</p>
        <h2 class="means__h">What this means if you work here</h2>
        <p class="muted">
          Adult First isn’t just for classrooms. It shapes how we support our own people — because regulated adults are the
          foundation of everything we do for children.
        </p>
        <a class="link-arrow" href="/careers">Careers at STARS</a>
      </div>
    </div>
  </section>

  <NextSteps
    heading="See our approach in action."
    body="The best way to understand how STARS feels is to visit. Come see the classrooms, meet the team and ask anything."
    primary={{ label: 'Schedule a tour', href: '/schedule-a-tour' }}
    secondary={{ label: 'Explore services', href: '/services' }}
    links={[
      { label: 'Getting started', href: '/getting-started', description: 'Eligibility, funding and the steps to enroll.' },
      { label: 'About STARS', href: '/about-us', description: 'Our story, vision and values.' },
    ]}
  />
</BaseLayout>

<style>
  .short__lead {
    max-width: 58rem;
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.3;
    color: var(--navy-900);
  }
  .short__lead strong {
    font-weight: 500;
    color: var(--red-700);
    font-style: italic;
  }
  .short__label {
    display: block;
    margin-bottom: var(--space-xs);
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-600);
  }
  .jump {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    padding-block: 0.5rem;
    background: var(--paper);
    border-block: 1px solid var(--color-line-soft);
  }
  @media (min-width: 72em) {
    .jump {
      top: calc(var(--header-h) + 2.5rem);
    }
  }
  .jump ul {
    display: flex;
    gap: 0.25rem 1.25rem;
    overflow-x: auto;
    padding: 0;
    list-style: none;
    scrollbar-width: none;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    white-space: nowrap;
    font-size: 0.925rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink-700);
  }
  .jump a:hover {
    color: var(--red-700);
  }
  .ideas {
    padding-block: var(--space-xl) var(--space-2xl);
  }
  .idea {
    display: grid;
    gap: var(--space-m);
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--color-line);
    scroll-margin-top: calc(var(--header-h) + 5rem);
  }
  .idea__head {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
  }
  .idea__mark {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }
  .idea__n {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--gold-700);
  }
  .idea h2 {
    font-size: var(--step-3);
  }
  .idea__body {
    display: grid;
    gap: var(--space-s);
    max-width: 38rem;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-700);
  }
  .idea__looks {
    padding: var(--space-s) var(--space-m);
    background: var(--white);
    border-left: 3px solid var(--gold-400);
    border-radius: 0 var(--radius-m) var(--radius-m) 0;
    font-size: var(--step-0);
  }
  .idea__looks-label {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--red-700);
    margin-bottom: 0.25rem;
  }
  .ideas__note {
    margin-top: var(--space-m);
  }
  .means {
    display: grid;
    gap: var(--space-xl);
  }
  .means ul {
    display: grid;
    gap: var(--space-xs);
    padding-left: 1.2rem;
    font-size: var(--step-1);
  }
  .means li::marker {
    color: var(--red-600);
  }
  .means__h {
    font-size: var(--step-3);
  }
  .means .btn {
    justify-self: start;
  }
  @media (min-width: 60em) {
    .idea {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--space-2xl);
    }
    .means {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }
  }
</style>
