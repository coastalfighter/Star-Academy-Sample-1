---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/figtree';
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { organizationSchema } from '@/lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: (Record<string, unknown> | null)[];
}

const { title, description, image, noindex, jsonLd = [] } = Astro.props;
const site = Astro.site ?? new URL('https://www.mystarsacademy.org');
const ga4 = import.meta.env.PUBLIC_GA4_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#17153a" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {title} {description} {image} {noindex} jsonLd={[organizationSchema(site), ...jsonLd]} />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Safety net: if the motion script never loads, reveal everything.
      setTimeout(function () {
        if (document.documentElement.hasAttribute('data-motion')) return;
        document.querySelectorAll('[data-reveal]').forEach(function (el) {
          el.classList.add('is-visible');
        });
        document.querySelectorAll('h2 em').forEach(function (el) {
          el.classList.add('is-drawn');
        });
      }, 2500);
    </script>
    {
      ga4 && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} />
          <script is:inline define:vars={{ ga4 }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', ga4, { anonymize_ip: true });
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { initReveal } from '@/scripts/reveal';
      import { initScroll3d } from '@/scripts/scroll3d';
      initReveal();
      initScroll3d();
    </script>
  </body>
</html>
