---
/**
 * Duotone line icons — the site's illustration vocabulary.
 * A soft tinted shape (fill) sits under a crisp brand-colored line, which
 * reads as considered and clinical-grade rather than cartoonish.
 * Decorative by default; pass `label` when the icon carries meaning alone.
 */
export type DuoName =
  | 'speech'
  | 'hand'
  | 'steps'
  | 'nursing'
  | 'blocks'
  | 'team'
  | 'calm'
  | 'senses'
  | 'neuro'
  | 'phone'
  | 'home'
  | 'clipboard'
  | 'stethoscope'
  | 'star'
  | 'sun'
  | 'apple'
  | 'family'
  | 'briefcase'
  | 'shield'
  | 'calendar'
  | 'heart'
  | 'van';

interface Props {
  name: DuoName;
  size?: number;
  tone?: 'navy' | 'red' | 'gold' | 'teal' | 'inverse';
  chip?: boolean;
  label?: string;
  class?: string;
}

const { name, size = 28, tone = 'navy', chip = false, label, class: className } = Astro.props;

