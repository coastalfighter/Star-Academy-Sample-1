const icon = icons[name];
---

<span class:list={['duo', `duo--${tone}`, { 'duo--chip': chip }, className]} style={`--duo-size:${size}px`}>
  <svg
    viewBox="0 0 24 24"
    width={size}
    height={size}
    role={label ? 'img' : undefined}
    aria-label={label}
    aria-hidden={label ? undefined : 'true'}
    focusable="false"
  >
    <g class="duo__fill" set:html={icon.f} />
    <g
      class="duo__line"
      fill="none"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      set:html={icon.s}
    />
  </svg>
</span>

<style>
  .duo {
    --duo-line: var(--navy-800);
    --duo-fill: rgb(242 194 48 / 0.45);
    --duo-bg: var(--gold-200);
    display: inline-grid;
    place-items: center;
    flex: none;
    line-height: 0;
  }
  .duo--red {
    --duo-line: var(--red-700);
    --duo-fill: rgb(196 50 58 / 0.16);
    --duo-bg: var(--red-100);
  }
  .duo--gold {
    --duo-line: var(--navy-800);
    --duo-fill: rgb(242 194 48 / 0.55);
    --duo-bg: #fbf0cc;
  }
  .duo--teal {
    --duo-line: var(--teal-700);
    --duo-fill: rgb(46 122 140 / 0.2);
    --duo-bg: var(--teal-100);
  }
  .duo--inverse {
    --duo-line: #ffffff;
    --duo-fill: rgb(242 194 48 / 0.35);
    --duo-bg: rgb(255 255 255 / 0.08);
  }
  .duo__fill {
    fill: var(--duo-fill);
  }
  .duo__line {
    stroke: var(--duo-line);
  }
  .duo--chip {
    width: calc(var(--duo-size) * 1.9);
    height: calc(var(--duo-size) * 1.9);
    border-radius: 34% 42% 38% 46% / 42% 36% 46% 38%;
    background: var(--duo-bg);
    transition:
      transform var(--duration-m) var(--ease-out),
      border-radius 900ms var(--ease-out);
  }
  :global(:hover) > .duo--chip,
  :global(a:hover) .duo--chip {
    transform: rotate(-6deg) scale(1.06);
    border-radius: 46% 36% 44% 38% / 38% 46% 36% 44%;
  }
</style>
