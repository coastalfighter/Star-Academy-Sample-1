---
import Icon from '../Icon.astro';
import Photo from '../Photo.astro';
import AnimatedTitle from '../AnimatedTitle.astro';
import DuoIcon from '../graphics/DuoIcon.astro';
import Sparkles from '../graphics/Sparkles.astro';
import { SITE } from '@/lib/site';
---

<div class="hero-track" data-3d="hero-pin" data-3d-track="sticky">
<section class="hero pattern-care" aria-labelledby="hero-title" data-3d="hero" data-3d-track="exit">
  <div class="container hero__grid">
    <div class="hero__text depth-text">
      <p class="eyebrow">Pediatric therapy &amp; developmental preschool · Batesville</p>
      <AnimatedTitle id="hero-title" html="Therapy, learning and care for young children, <em>woven into one full&nbsp;day.</em>" />
      <p class="hero__lede anim-lede">
        STARS Academy serves children from birth to age six who need extra support with development. Speech,
        occupational and physical therapy, licensed nursing care and developmental classrooms all happen here — together,
        with one team that knows your child.
      </p>
      <div class="cluster hero__actions anim-actions">
        <a class="btn" href="/getting-started">
          See if STARS is right for your child
          <span class="btn__arrow"><Icon name="arrow-right" size={18} /></span>
        </a>
        <a class="btn btn--secondary" href="/schedule-a-tour">Schedule a tour</a>
      </div>
      <p class="hero__call small anim-actions">
        Prefer to talk? Call <a href={SITE.phoneHref}>{SITE.phone}</a> — weekdays {SITE.hours.open}–{SITE.hours.close}
      </p>
    </div>

    <div class="hero__media depth-stage">
      <div class="depth-rig">
      <div class="depth-layer depth-far" aria-hidden="true"><div class="hero__blob"></div></div>
      <ul class="orbit" role="list" aria-hidden="true">
        <li style="--ox:-1.15;--oy:-0.62;--r:-10deg"><DuoIcon name="speech" size={24} tone="red" chip /></li>
        <li style="--ox:1.05;--oy:-0.78;--r:12deg"><DuoIcon name="hand" size={24} tone="teal" chip /></li>
        <li style="--ox:1.2;--oy:0.1;--r:-8deg"><DuoIcon name="steps" size={24} tone="gold" chip /></li>
        <li style="--ox:-1.2;--oy:0.28;--r:9deg"><DuoIcon name="nursing" size={24} tone="red" chip /></li>
        <li style="--ox:-0.2;--oy:-1.02;--r:-4deg"><DuoIcon name="blocks" size={24} tone="gold" chip /></li>
      </ul>
      <Sparkles variant="hero" />
      <Photo
        image="story-time-close"
        sizes="(min-width: 60em) 34rem, 88vw"
        class="hero__photo"
        ratio="4 / 5"
        tone="sand"
        priority
        brief="A therapist and a preschooler at eye level in a sunlit classroom, mid-laugh — real STARS moment, natural light."
        tilt
      />
      <div class="depth-layer depth-near">
      <div class="hero__card" role="group" aria-label="On-site care team">
        <p class="hero__card-title">One team, on site</p>
        <ul role="list">
          <li><DuoIcon name="speech" size={20} tone="red" chip /> Speech</li>
          <li><DuoIcon name="hand" size={20} tone="teal" chip /> Occupational</li>
          <li><DuoIcon name="steps" size={20} tone="gold" chip /> Physical</li>
          <li><DuoIcon name="nursing" size={20} tone="red" chip /> Nursing</li>
        </ul>
      </div>
      <div class="hero__inset" aria-hidden="true">
        <Photo image="ball-pit-play" sizes="14rem" ratio="1 / 1" tone="gold" brief="Small hands on sensory play — beans, scoops, a teacher's hand nearby." />
      </div>
      </div>
      </div>
    </div>
  </div>

  <p class="hero__cue" aria-hidden="true"><span class="hero__cue-line"></span>Scroll to explore</p>
</section>
</div>

<div class="hero-facts-wrap">
  <div class="container">
    <dl class="hero__facts">
      <div>
        <dt>Serving families since</dt>
        <dd>{SITE.founded}</dd>
      </div>
      <div>
        <dt>Children from</dt>
        <dd>Birth to age 6</dd>
      </div>
      <div>
        <dt>Paid through</dt>
        <dd>Medicaid, incl. ARKids First-A, SSI &amp; TEFRA</dd>
      </div>
      <div>
        <dt>Speech therapy</dt>
        <dd>Offered in English &amp; Spanish</dd>
      </div>
    </dl>
  </div>
</div>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-l) var(--space-xl);
    overflow: hidden;
  }
  .hero::after {
    /* Soft warm light behind the composition — no loud gradients. */
    content: '';
    position: absolute;
    inset: -20% -10% auto auto;
    width: 60vw;
    height: 60vw;
    max-width: 52rem;
    max-height: 52rem;
    background: radial-gradient(closest-side, rgb(242 194 48 / 0.16), transparent);
    pointer-events: none;
  }
  .hero__grid {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }
  .hero__text {
    display: grid;
    gap: var(--space-s);
    max-width: 40rem;
  }
  .hero :global(h1) {
    font-size: clamp(2.35rem, 1.6rem + 3.6vw, 4.6rem);
    line-height: 1.04;
  }
  .hero__lede {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-700);
    max-width: 36rem;
  }
  .hero__actions {
    margin-top: var(--space-2xs);
  }
  .hero__call {
    color: var(--ink-600);
  }
  .hero__call a {
    font-weight: 650;
    white-space: nowrap;
  }
  .hero__media {
    position: relative;
    max-width: 34rem;
    width: 100%;
    justify-self: center;
  }
  .depth-rig {
    position: relative;
    padding-left: 12%;
  }
  .depth-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .depth-far {
    z-index: 0;
  }
  .depth-near {
    z-index: 3;
  }
  .depth-near > * {
    pointer-events: auto;
  }
  .hero__blob {
    position: absolute;
    z-index: 0;
    inset: 6% -6% -4% 18%;
    background: linear-gradient(145deg, rgb(242 194 48 / 0.35), rgb(46 122 140 / 0.18));
    border-radius: 58% 42% 52% 48% / 46% 56% 44% 54%;
  }
  .depth-rig > :global(.photo) {
    position: relative;
    z-index: 1;
    box-shadow: var(--shadow-m);
  }
  .hero__card {
    position: absolute;
    z-index: 3;
    right: -4%;
    bottom: 6%;
    display: grid;
    gap: 0.55rem;
    padding: 0.9rem 1rem 1rem;
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-m);
  }
  .hero__card-title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-600);
  }
  .hero__card ul {
    display: grid;
    gap: 0.45rem;
    padding: 0;
    list-style: none;
  }
  .hero__card li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--navy-900);
  }
  .hero__card :global(.duo--chip) {
    width: 30px;
    height: 30px;
  }
  @media (max-width: 29.99em) {
    .hero__card {
      right: 0;
      bottom: -6%;
      padding: 0.7rem 0.8rem;
    }
    .hero__card ul {
      grid-template-columns: 1fr 1fr;
      column-gap: 0.8rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__blob {
      animation: blob-morph 18s ease-in-out infinite;
    }
    .hero__card {
      animation:
        word-rise 900ms var(--ease-out) 1100ms both,
        gentle-float 7s ease-in-out 2s infinite;
    }
    .hero__inset {
      animation: word-rise 900ms var(--ease-out) 900ms both;
    }
  }
  .hero__inset {
    position: absolute;
    z-index: 2;
    left: 0;
    top: 10%;
    width: 38%;
    padding: 6px;
    background: var(--paper);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-m);
  }
  .hero__inset :global(.photo__note) {
    display: none;
  }
  .hero__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    gap: 0 var(--space-s);
    margin-top: var(--space-xl);
    border-top: 1px solid var(--color-line);
  }
  .hero__facts > div {
    padding: var(--space-s) var(--space-s) 0 0;
  }
  .hero__facts dt {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-600);
  }
  .hero__facts dd {
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.3;
    color: var(--navy-900);
  }
  @media (min-width: 60em) {
    .hero {
      padding-top: var(--space-xl);
    }
    .hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
    .hero__facts > div + div {
      padding-left: var(--space-s);
      border-left: 1px solid var(--color-line);
    }
  }

  .hero-facts-wrap {
    position: relative;
    padding-bottom: var(--space-xl);
    background: var(--paper);
  }
  .hero-facts-wrap .hero__facts {
    margin-top: 0;
  }

  /* Orbiting service icons and the scroll cue exist only in the pinned story. */
  .orbit,
  .hero__cue {
    display: none;
  }

  /* ---------- Pinned hero scroll story (desktop, tall enough screens) ----------
     The track is ~190vh; the hero sticks under the header while --ps goes 0→1:
       0.00–0.55  photo swings in 3D, service icons spread into orbit,
                  care card lifts toward you, inset drifts away
       0.35–1.00  headline eases back; the whole stage settles into a card */
  @media (min-width: 60em) and (min-height: 46em) {
    :global(.has-3d) .hero-track {
      --hp: var(--ps, 0);
      --e: clamp(0, calc(var(--hp) * 1.9), 1);
      --late: clamp(0, calc((var(--hp) - 0.55) / 0.45), 1);
      height: 195vh;
      background: var(--sand-100);
    }
    :global(.has-3d) .hero {
      position: sticky;
      top: var(--stick-top, var(--header-h));
      min-height: calc(100vh - var(--stick-top, var(--header-h)));
      display: grid;
      align-content: center;
      padding-block: var(--space-m);
      transform: scale(calc(1 - var(--late) * 0.05));
      border-radius: calc(var(--late) * 28px);
      box-shadow: 0 30px 70px -40px rgb(23 21 58 / calc(var(--late) * 0.5));
      background: var(--paper);
      transform-origin: 50% 0;
    }
    :global(.has-3d) .hero__media {
      max-width: 30rem;
    }
    /* The photo rig swings and leans back in 3D. */
    :global(.has-3d) .hero .depth-rig {
      transform: rotateY(calc(var(--e) * -14deg)) rotateX(calc(var(--e) * 6deg))
        scale(calc(1 + var(--e) * 0.03));
      transition: none;
    }
    :global(.has-3d) .hero .depth-far {
      transform: translateZ(-90px) scale(calc(1 + var(--e) * 0.22)) rotate(calc(var(--e) * 14deg));
    }
    :global(.has-3d) .hero .depth-near {
      transform: translateZ(calc(40px + var(--e) * 110px)) translateY(calc(var(--e) * -26px));
    }
    :global(.has-3d) .hero .hero__inset {
      translate: calc(var(--e) * -46px) calc(var(--e) * -28px);
      rotate: calc(var(--e) * -7deg);
    }
    :global(.has-3d) .hero .depth-text {
      transform: translateY(calc(var(--hp) * -34px));
      opacity: calc(1 - var(--late) * 0.3);
    }

    /* Five service icons spread out from behind the photo into orbit. */
    :global(.has-3d) .orbit {
      display: block;
      position: absolute;
      left: 56%;
      top: 50%;
      z-index: 4;
      margin: 0;
      padding: 0;
      list-style: none;
      transform: translateZ(70px);
      pointer-events: none;
    }
    :global(.has-3d) .orbit li {
      position: absolute;
      left: -1.6rem;
      top: -1.6rem;
      --dist: min(15rem, 30vw);
      transform: translate(calc(var(--ox) * var(--dist) * var(--e)), calc(var(--oy) * var(--dist) * var(--e)))
        rotate(calc(var(--r) * var(--e))) scale(calc(0.4 + var(--e) * 0.6));
      opacity: var(--e);
    }
    :global(.has-3d) .orbit :global(.duo--chip) {
      box-shadow: 0 12px 26px -14px rgb(23 21 58 / 0.45);
      background: var(--white);
    }

    /* Scroll cue fades away as soon as the story starts. */
    :global(.has-3d) .hero__cue {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      position: absolute;
      left: 50%;
      bottom: 1.2rem;
      translate: -50% 0;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ink-600);
      opacity: calc(1 - var(--hp) * 5);
    }
    :global(.has-3d) .hero__cue-line {
      position: relative;
      width: 1.6rem;
      height: 2.6rem;
      border: 1.5px solid var(--sand-300);
      border-radius: 1rem;
    }
    :global(.has-3d) .hero__cue-line::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 0.5rem;
      width: 4px;
      height: 8px;
      margin-left: -2px;
      border-radius: 2px;
      background: var(--red-600);
      animation: cue-drop 1.8s var(--ease-out) infinite;
    }
  }
  @media (min-width: 72em) {
    :global(.has-3d) .hero-track {
      --stick-top: calc(var(--header-h) + 2.5rem);
    }
  }
  @keyframes cue-drop {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    70% {
      transform: translateY(12px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 0;
    }
  }
</style>
