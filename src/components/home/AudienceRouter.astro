---
import Icon from '../Icon.astro';

const routes = [
  { who: 'Parents & caregivers', action: 'Explore STARS for my child', href: '/getting-started' },
  { who: 'Current STARS families', action: 'Find family information', href: '/families' },
  { who: 'Physicians & schools', action: 'Refer a child', href: '/referrals' },
  { who: 'Therapists, nurses & educators', action: 'Work at STARS', href: '/careers' },
];
---

<nav class="router" aria-labelledby="router-title">
  <div class="container">
    <h2 id="router-title" class="router__title">Find your way</h2>
    <ul role="list" class="router__list">
      {
        routes.map((r) => (
          <li>
            <a href={r.href} class="router__link">
              <span class="router__who">{r.who}</span>
              <span class="router__action">
                {r.action}
                <Icon name="arrow-right" size={18} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .router {
    background: var(--navy-900);
    color: #ffffff;
    --color-focus: var(--gold-400);
  }
  .router__title {
    padding-top: var(--space-s);
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-400);
  }
  .router__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    padding: 0;
    list-style: none;
  }
  .router__list li {
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
  }
  .router__link {
    display: grid;
    gap: 0.2rem;
    padding-block: var(--space-s);
    padding-right: var(--space-s);
    color: #ffffff;
    text-decoration: none;
  }
  .router__who {
    font-size: var(--step--1);
    color: #c7c5dc;
  }
  .router__action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .router__action :global(svg) {
    color: var(--gold-400);
    transition: transform var(--duration-m) var(--ease-out);
  }
  .router__link:hover .router__action {
    color: var(--gold-400);
  }
  .router__link:hover :global(svg) {
    transform: translateX(4px);
  }
  @media (min-width: 64em) {
    .router__list li {
      border-bottom: 0;
    }
    .router__list li + li .router__link {
      padding-left: var(--space-s);
      border-left: 1px solid rgb(255 255 255 / 0.14);
    }
    .router__link {
      padding-bottom: var(--space-m);
    }
  }
</style>
