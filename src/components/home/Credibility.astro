---
import Confirm from '../Confirm.astro';
import { SITE } from '@/lib/site';

const stats = [
  { value: String(SITE.founded), label: 'Year founded — locally owned and operated' },
  { value: String(SITE.childrenServed), label: 'Children currently served (approx.)' },
  { value: String(SITE.staffCount), label: 'Teachers, therapists, nurses and staff (approx.)' },
  { value: '2', label: 'Family-friendly Batesville facilities' },
];
---

<section class="section cred" aria-labelledby="cred-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Why families trust STARS</p>
      <h2 id="cred-title">An established team, <em>rooted in this community.</em></h2>
    </div>

    <dl class="cred__stats">
      {
        stats.map((s, i) => (
          <div data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
    </dl>

    <figure class="cred__quote" data-reveal>
      <svg class="cred__mark" viewBox="0 0 40 32" aria-hidden="true">
        <path
          d="M0 32V19.2C0 8.53 5.33 2.13 16 0l1.6 4.27C11.73 6.13 8.8 9.6 8.8 14.4H16V32H0Zm22.4 0V19.2C22.4 8.53 27.73 2.13 38.4 0L40 4.27c-5.87 1.86-8.8 5.33-8.8 10.13h7.2V32H22.4Z"
          fill="currentColor"></path>
      </svg>
      <blockquote>
        <p><Confirm note="A real family testimonial, shared with written permission (2–3 sentences)" /></p>
      </blockquote>
      <figcaption><Confirm note="Parent first name, and child's age or program — with permission" /></figcaption>
    </figure>
  </div>
</section>

<style>
  .cred__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12.5rem), 1fr));
    gap: var(--space-m);
  }
  .cred__stats > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-2xs);
    padding-top: var(--space-s);
    border-top: 2px solid var(--navy-900);
  }
  .cred__stats dd {
    font-family: var(--font-display);
    font-size: var(--step-5);
    line-height: 1;
    font-weight: 350;
    color: var(--navy-900);
    font-variant-numeric: lining-nums;
  }
  .cred__stats dt {
    color: var(--ink-700);
    max-width: 16rem;
  }
  .cred__quote {
    display: grid;
    gap: var(--space-s);
    max-width: 50rem;
    margin: var(--space-2xl) auto 0;
    text-align: center;
    justify-items: center;
  }
  .cred__mark {
    width: 2.5rem;
    color: var(--gold-400);
  }
  .cred__quote blockquote p {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.4;
    color: var(--navy-900);
  }
  .cred__quote figcaption {
    color: var(--ink-600);
  }
</style>
