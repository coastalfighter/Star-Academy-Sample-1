---
/**
 * End-of-page "where to go next". Every major page ends here so no visitor
 * reaches a dead end. One primary action, up to three contextual links.
 */
import Icon from './Icon.astro';
import type { NavLink } from '@/lib/navigation';

interface Props {
  heading: string;
  body?: string;
  primary: NavLink;
  secondary?: NavLink;
  links?: NavLink[];
}
const { heading, body, primary, secondary, links = [] } = Astro.props;
---

<section class="section section--navy next" aria-labelledby="next-heading">
  <div class="container next__grid">
    <div class="next__lead" data-reveal>
      <p class="eyebrow">Next step</p>
      <h2 id="next-heading">{heading}</h2>
      {body && <p class="lede">{body}</p>}
      <div class="cluster next__actions">
        <a class="btn" href={primary.href}>
          {primary.label}
          <span class="btn__arrow"><Icon name="arrow-right" size={18} /></span>
        </a>
        {secondary && <a class="btn btn--secondary" href={secondary.href}>{secondary.label}</a>}
      </div>
    </div>
    {
      links.length > 0 && (
        <ul class="next__links" role="list" data-reveal style="--reveal-delay: 120ms">
          {links.map((l) => (
            <li>
              <a href={l.href}>
                <span>
                  <span class="next__label">{l.label}</span>
                  {l.description && <span class="next__desc">{l.description}</span>}
                </span>
                <Icon name="arrow-right" size={20} />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .next__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }
  .next__lead {
    display: grid;
    gap: var(--space-s);
  }
  .next__actions {
    margin-top: var(--space-xs);
  }
  .next__links {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .next__links li {
    border-bottom: 1px solid var(--color-line);
  }
  .next__links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-s);
    text-decoration: none;
    color: #ffffff;
  }
  .next__links a > span {
    display: grid;
    gap: 0.2rem;
  }
  .next__label {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .next__desc {
    font-size: var(--step--1);
    color: #c7c5dc;
  }
  .next__links :global(svg) {
    flex: none;
    color: var(--gold-400);
    transition: transform var(--duration-m) var(--ease-out);
  }
  .next__links a:hover :global(svg) {
    transform: translateX(4px);
  }
  .next__links a:hover .next__label {
    color: var(--gold-400);
  }
  @media (min-width: 60em) {
    .next__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
