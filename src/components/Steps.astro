---
/** Numbered process — an ordered list with editorial numbering. */
import Rich from './Rich.astro';

interface Props {
  steps: { title: string; body: string }[];
  layout?: 'row' | 'column';
}
const { steps, layout = 'row' } = Astro.props;
---

<ol class:list={['steps', `steps--${layout}`]} role="list">
  {
    steps.map((step, i) => (
      <li class="step" data-3d="flip">
        <span class="step__num" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="step__title">
          <span class="visually-hidden">Step {i + 1}: </span>
          {step.title}
        </h3>
        <Rich as="p" class="step__body" text={step.body} />
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    gap: var(--space-l) var(--space-m);
    padding: 0;
    list-style: none;
  }
  .step {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
    padding-top: var(--space-s);
    border-top: 2px solid var(--color-heading);
  }
  .step__num {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-style: italic;
    line-height: 1;
    color: var(--color-accent-text);
  }
  .step__title {
    font-size: var(--step-1);
    font-weight: 500;
  }
  .step__body {
    color: var(--color-text-muted);
  }
  @media (min-width: 48em) {
    .steps--row {
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    }
  }
  .steps--column .step {
    grid-template-columns: 3.5rem 1fr;
    column-gap: var(--space-s);
  }
  .steps--column .step__num {
    grid-row: span 2;
  }
</style>
