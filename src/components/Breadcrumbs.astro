---
import type { Crumb } from '@/lib/seo';

interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="crumbs">
  <ol role="list">
    {
      items.map((item, i) => (
        <li>
          {i < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    color: var(--ink-600);
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .crumbs li + li::before {
    content: '/';
    color: var(--sand-300);
  }
  .crumbs a {
    color: var(--ink-700);
    text-decoration: none;
    padding-block: 0.35rem;
  }
  .crumbs a:hover {
    color: var(--red-700);
    text-decoration: underline;
  }
  .crumbs [aria-current] {
    color: var(--navy-800);
    font-weight: 600;
  }
</style>
